{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "View Site (Live Server - Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5500/index.html",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "View Site (Live Server - Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://127.0.0.1:5500/index.html",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "View Site (Direct File - Chrome)",
      "type": "chrome",
      "request": "launch",
      "file": "${workspaceFolder}/index.html"
    },
    {
      "name": "View Site (Direct File - Edge)",
      "type": "msedge",
      "request": "launch",
      "file": "${workspaceFolder}/index.html"
    }
  ]
}
